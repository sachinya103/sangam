# GEMINI_API_KEY: Optional for AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where Sangam Mobile Centre is hosted.
APP_URL="https://sangammobilecentre.com"

# ADMIN_PASSCODE: Set your store owner admin passcode here in production.
# If left empty, the first visit to /admin/login lets you claim an owner passcode.
ADMIN_PASSCODE=

# Optional Production Integrations (MongoDB Atlas, Firebase OTP, Cloudinary, Razorpay)
MONGODB_URI=
FIREBASE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
